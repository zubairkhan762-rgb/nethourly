---
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
	{ href: '/', label: 'Pay calculator', shortLabel: 'Pay' },
	{ href: '/24-hour-shift-calculator', label: '24-hour shifts', shortLabel: '24-hour' },
	{ href: '/overtime-calculator', label: 'Overtime', shortLabel: 'Overtime' },
	{ href: '/popular-wages', label: 'Popular wages', shortLabel: 'Wages' },
];

const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname === href;

const calculatorHref = pathname === '/popular-wages' ? '/#calculator-band' : '#calculator';
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/" aria-label="Nethourly home">
			<span class="mark" aria-hidden="true">N</span>
			<span class="wordmark">Nethourly<span class="tld">.com</span></span>
		</a>
		<nav class="nav" aria-label="Primary">
			{links.map((link) => (
				<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
					<span class="nav-full">{link.label}</span>
					<span class="nav-short">{link.shortLabel}</span>
				</a>
			))}
		</nav>
		<a class="header-cta" href={calculatorHref}>Calculate pay</a>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(250, 250, 250, 0.82);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid var(--hairline);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 64px;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 2px;
		margin-right: 12px;
	}

	.nav a {
		padding: 7px 11px;
		border-radius: 100px;
		font-size: 14px;
		color: var(--body);
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.nav a:hover {
		background: var(--hairline-soft);
		color: var(--ink);
	}

	.nav a[aria-current='page'] {
		background: var(--hairline-soft);
		color: var(--ink);
	}

	.nav-short {
		display: none;
	}

	.header-cta {
		display: inline-flex;
		align-items: center;
		height: 32px;
		padding: 0 12px;
		border-radius: 6px;
		background: var(--ink);
		color: #ffffff;
		font-size: 13px;
		font-weight: 500;
		transition: background 0.15s ease;
	}

	.header-cta:hover {
		background: #333333;
	}

	@media (max-width: 760px) {
		.header-cta {
			display: none;
		}

		.nav {
			margin-right: 0;
		}

		.nav-full {
			display: none;
		}

		.nav-short {
			display: inline;
		}

		.nav a {
			padding: 7px 9px;
			font-size: 13px;
		}
	}

	@media (max-width: 420px) {
		.wordmark {
			display: none;
		}

		.header-inner {
			gap: 4px;
		}

		.nav a {
			padding: 6px 7px;
			font-size: 12px;
		}
	}
</style>
