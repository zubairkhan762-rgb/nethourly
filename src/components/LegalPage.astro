---
import Breadcrumbs from './Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';

interface TocItem {
	id: string;
	label: string;
}

interface Props {
	title: string;
	description: string;
	eyebrow: string;
	heading: string;
	lede: string;
	updated: string;
	breadcrumbLabel: string;
	toc: TocItem[];
}

const { title, description, eyebrow, heading, lede, updated, breadcrumbLabel, toc } =
	Astro.props;

const breadcrumbs = [
	{ label: 'Home', href: '/' },
	{ label: breadcrumbLabel },
];
---

<Layout title={title} description={description}>
	<Breadcrumbs items={breadcrumbs} />

	<section class="legal">
		<div class="shell legal-grid">
			<aside class="legal-toc" aria-label="On this page">
				<span class="mono">On this page</span>
				<nav>
					{toc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
				</nav>
			</aside>

			<article class="legal-body">
				<header class="legal-head">
					<p class="eyebrow mono">{eyebrow}</p>
					<h1>{heading}</h1>
					<p class="legal-lede">{lede}</p>
					<p class="legal-updated mono">Last updated: {updated}</p>
				</header>
				<slot />
			</article>
		</div>
	</section>
</Layout>

<style is:global>
	.legal {
		padding: 72px 0 96px;
		border-top: 1px solid var(--hairline);
	}

	.legal-grid {
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr);
		gap: 72px;
		align-items: start;
	}

	.legal-toc {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.legal-toc > .mono {
		color: var(--mute);
	}

	.legal-toc nav {
		display: flex;
		flex-direction: column;
		border-left: 1px solid var(--hairline);
	}

	.legal-toc a {
		padding: 7px 0 7px 14px;
		font-size: 13px;
		line-height: 18px;
		color: var(--body);
		transition: color 0.15s ease;
	}

	.legal-toc a:hover {
		color: var(--ink);
	}

	.legal-body {
		max-width: 760px;
	}

	.legal-head .eyebrow {
		color: var(--mute);
	}

	.legal-head h1 {
		margin: 12px 0 0;
		font-size: clamp(34px, 5vw, 52px);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -2px;
		text-wrap: balance;
	}

	.legal-lede {
		margin: 18px 0 0;
		font-size: 17px;
		line-height: 28px;
		color: var(--body);
	}

	.legal-updated {
		margin: 16px 0 0;
		font-size: 12px;
		color: var(--faint);
	}

	.legal-body h2 {
		margin: 44px 0 0;
		font-size: clamp(24px, 3.2vw, 30px);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -1px;
		scroll-margin-top: 96px;
	}

	.legal-body h3 {
		margin: 28px 0 0;
		font-size: 18px;
		font-weight: 600;
		line-height: 24px;
		letter-spacing: -0.3px;
		scroll-margin-top: 96px;
	}

	.legal-body p {
		margin: 12px 0 0;
		font-size: 15px;
		line-height: 26px;
		color: var(--body);
	}

	.legal-body ul,
	.legal-body ol {
		margin: 12px 0 0;
		padding: 0 0 0 22px;
	}

	.legal-body li {
		margin: 8px 0 0;
		font-size: 15px;
		line-height: 25px;
		color: var(--body);
	}

	.legal-body strong {
		color: var(--ink);
		font-weight: 500;
	}

	.legal-body a {
		color: var(--link);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.legal-note {
		margin: 20px 0 0;
		padding: 16px 18px;
		border: 1px solid var(--hairline);
		border-radius: 8px;
		background: var(--canvas-elevated);
	}

	.legal-note p {
		margin: 0;
	}

	.legal-body table {
		width: 100%;
		margin: 16px 0 0;
		border-collapse: collapse;
		font-size: 14px;
	}

	.legal-body th,
	.legal-body td {
		padding: 10px 12px;
		border-bottom: 1px solid var(--hairline);
		text-align: left;
		vertical-align: top;
	}

	.legal-body th {
		font-weight: 500;
		color: var(--ink);
		background: var(--canvas);
	}

	@media (max-width: 960px) {
		.legal-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}

		.legal-grid > * {
			min-width: 0;
		}

		.legal-toc {
			position: static;
		}

		.legal-toc nav {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 6px 18px;
			border-top: 1px solid var(--hairline);
			border-left: 0;
			padding-top: 10px;
		}

		.legal-toc a {
			padding: 4px 0;
		}
	}

	@media (max-width: 640px) {
		.legal {
			padding: 48px 0 72px;
		}

		.legal-lede {
			font-size: 15px;
			line-height: 24px;
		}
	}
</style>
