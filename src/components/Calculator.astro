---
import {
	calculateStandard,
	FICA_RATE,
	getFrequencyRows,
	STATE_TAX_PROFILES,
	TAX_SCENARIOS,
} from '../lib/payroll';

interface Props {
	hourlyRate?: number;
}

const { hourlyRate = 25 } = Astro.props;

const initialInput = {
	hourlyRate,
	hoursPerWeek: 40,
	doubleTimeHours: 0,
	weeksPerYear: 52,
};

const initial = calculateStandard(initialInput);
const initialTax = TAX_SCENARIOS.standard;
const initialFicaRate = Math.min(FICA_RATE, initialTax.rate);
const initialTaxAmount = initial.weeklyGross * initialTax.rate;
const initialFicaAmount = initial.weeklyGross * initialFicaRate;
const initialFedStateAmount =
	initial.weeklyGross * Math.max(0, initialTax.rate - initialFicaRate);
const initialNetWeekly = initial.weeklyGross - initialTaxAmount;
const initialRows = getFrequencyRows(initial, initialInput.hourlyRate, initialInput.weeksPerYear);
const initialTakeHomeRate = 1 - initialTax.rate;
const initialFedStateRate = Math.max(0, initialTax.rate - initialFicaRate);
const initialMonthlyNet = initial.annualGross * initialTakeHomeRate / 12;

const money = (value: number) =>
	value.toLocaleString('en-US', {
		style: 'currency',
		currency: 'USD',
		minimumFractionDigits: 2,
		maximumFractionDigits: 2,
	});

const hours = (value: number) =>
	value.toLocaleString('en-US', { maximumFractionDigits: 1 });

const percent = (value: number) =>
	`${(Math.round(value * 10000) / 100).toLocaleString('en-US', { maximumFractionDigits: 2 })}%`;
---

<section id="calculator" class="calculator" aria-labelledby="calculator-title">
	<div class="calc-grid">
		<form id="pay-form" class="panel form-panel" novalidate>
			<div class="panel-head">
				<span class="mono">01 — Input</span>
				<h2 id="calculator-title">Your pay details</h2>
			</div>

			<div class="primary-fields">
				<label class="field">
					<span class="field-label">Hourly wage</span>
					<span class="control control-prefix">
						<span class="affix" aria-hidden="true">$</span>
						<input
							id="hourly-rate"
							name="hourly-rate"
							type="number"
							inputmode="decimal"
							min="0"
							max="10000"
							step="0.01"
							value={initialInput.hourlyRate}
						/>
					</span>
					<div class="wage-pills" role="group" aria-label="Quick-select hourly wage">
						{[15, 20, 25, 30, 35, 40].map((value) => (
							<button
								type="button"
								class="wage-pill"
								data-wage={value}
								aria-pressed={value === initialInput.hourlyRate ? 'true' : 'false'}
							>
								${value}
							</button>
						))}
					</div>
					<span class="hint">Base rate before overtime premiums or deductions.</span>
				</label>

				<div class="field-row primary-row">
					<label class="field">
						<span class="field-label">Regular hours per week</span>
						<span class="control control-suffix">
							<input
								id="hours-week"
								name="hours-week"
								type="number"
								inputmode="decimal"
								min="0"
								max="168"
								step="0.5"
								value={initialInput.hoursPerWeek}
							/>
							<span class="affix" aria-hidden="true">hrs</span>
						</span>
						<span class="hint">Default 40. Hours above 40 use the overtime premium.</span>
					</label>

					<label class="field">
						<span class="field-label">US state / tax profile</span>
						<span class="tax-select">
							<span class="sr-only">Tax estimate</span>
							<select id="tax-scenario" name="tax-scenario">
								{Object.entries(STATE_TAX_PROFILES).map(([key, profile]) => (
									<option value={`state:${key}`}>
										Net · {profile.label} ({profile.states})
									</option>
								))}
								<option value="standard" selected>Net · Standard (18%)</option>
								<option value="gross">Gross pay (0%)</option>
								<option value="fica">Net · FICA only (7.65%)</option>
								<option value="highTax">Net · High-tax state (24%)</option>
								<option value="noIncomeTax">Net · No income tax (15%)</option>
							</select>
						</span>
					</label>
				</div>
			</div>

			<details class="advanced" id="advanced-options">
				<summary class="advanced-summary">
					<span class="advanced-label">
						<span class="advanced-plus" aria-hidden="true">+</span>
						Overtime, Shift Bonus &amp; Weeks/Yr (Optional)
					</span>
					<span class="advanced-status" id="advanced-status" role="status" aria-live="polite" hidden>
						Active
					</span>
				</summary>

				<div class="advanced-body">
					<fieldset class="field mode-field">
						<legend class="field-label">Shift type</legend>
						<div class="segmented">
							<label>
								<input type="radio" name="shift-mode" value="standard" checked />
								<span>Standard week</span>
							</label>
							<label>
								<input type="radio" name="shift-mode" value="shift" />
								<span>24-hour shift</span>
							</label>
						</div>
					</fieldset>

					<div class="field diff-field">
						<div class="diff-head">
							<label class="field-label" for="shift-differential">Shift differential (+$/hr)</label>
							<span class="control control-prefix diff-control">
								<span class="affix" aria-hidden="true">+$</span>
								<input
									id="shift-differential"
									name="shift-differential"
									type="number"
									inputmode="decimal"
									min="0"
									max="50"
									step="0.25"
									value="0"
								/>
							</span>
						</div>
						<div class="diff-pills" role="group" aria-label="Shift differential presets">
							<button type="button" class="diff-pill" data-differential="0" aria-pressed="true">$0</button>
							<button type="button" class="diff-pill" data-differential="1.5" aria-pressed="false">+$1.50/hr</button>
							<button type="button" class="diff-pill" data-differential="3" aria-pressed="false">+$3/hr</button>
						</div>
						<span class="hint">Optional night or weekend add-on. Applied before overtime and shift pay.</span>
					</div>

					<div class="field-stack" data-panel="standard">
						<div class="field ot-field">
							<div class="ot-head">
								<label class="field-label" for="overtime-hours">Overtime hours</label>
								<span class="control control-suffix ot-control">
									<input
										id="overtime-hours"
										name="overtime-hours"
										type="number"
										inputmode="decimal"
										min="0"
										max="40"
										step="0.5"
										value={initial.overtimeHours}
										aria-label="Overtime hours"
									/>
									<span class="affix" aria-hidden="true">hrs</span>
								</span>
							</div>
							<input
								id="overtime-slider"
								name="overtime-slider"
								type="range"
								min="0"
								max="40"
								step="0.5"
								value={initial.overtimeHours}
								aria-label="Overtime hours slider, 0 to 40 hours"
							/>
							<span class="range-labels"><span>0 hrs</span><span>40 hrs</span></span>
						</div>

						<div class="field-row">
							<label class="field">
								<span class="field-label">Double-time hours</span>
								<span class="control control-suffix">
									<input
										id="double-time"
										name="double-time"
										type="number"
										inputmode="decimal"
										min="0"
										max="168"
										step="0.5"
										value={initialInput.doubleTimeHours}
									/>
									<span class="affix" aria-hidden="true">hrs</span>
								</span>
							</label>
							<fieldset class="field rate-field">
								<legend class="field-label">Overtime rate</legend>
								<div class="segmented segmented-compact">
									<label>
										<input type="radio" name="overtime-rate" value="1.5" checked />
										<span>1.5×</span>
									</label>
									<label>
										<input type="radio" name="overtime-rate" value="2" />
										<span>2×</span>
									</label>
								</div>
							</fieldset>
						</div>
						<p class="hint">Double-time hours sit inside the weekly total — holidays or California shifts past 12 hours.</p>
					</div>

					<div class="field-stack" data-panel="shift" hidden>
						<div class="field-row">
							<label class="field">
								<span class="field-label">Shifts per week</span>
								<span class="control control-suffix">
									<input
										id="shifts-week"
										name="shifts-week"
										type="number"
										inputmode="decimal"
										min="0"
										max="7"
										step="1"
										value="5"
									/>
									<span class="affix" aria-hidden="true">shifts</span>
								</span>
							</label>
							<label class="field">
								<span class="field-label">Sleep deduction</span>
								<span class="control control-suffix">
									<input
										id="sleep-deduction"
										name="sleep-deduction"
										type="number"
										inputmode="decimal"
										min="0"
										max="8"
										step="1"
										value="8"
									/>
									<span class="affix" aria-hidden="true">hrs</span>
								</span>
							</label>
						</div>
						<div class="field-row">
							<label class="field">
								<span class="field-label">Meal deduction</span>
								<span class="control control-suffix">
									<input
										id="meal-deduction"
										name="meal-deduction"
										type="number"
										inputmode="decimal"
										min="0"
										max="3"
										step="1"
										value="3"
									/>
									<span class="affix" aria-hidden="true">hrs</span>
								</span>
							</label>
							<div class="field">
								<span class="field-label">Payable per shift</span>
								<span class="readout" id="payable-per-shift">13 hrs</span>
							</div>
						</div>
						<label class="switch-row">
							<input id="daily-overtime" name="daily-overtime" type="checkbox" />
							<span class="switch" aria-hidden="true"></span>
							<span class="switch-copy">
								<strong>CA-style daily overtime</strong>
								<small>First 8 payable hours at 1×, hours 8–12 at 1.5×, beyond 12 at 2×.</small>
							</span>
						</label>
						<p class="hint">Sleep time is excludable up to 8 hours only with 5+ hours of uninterrupted sleep. Meals are excludable up to 3 duty-free hours.</p>
					</div>

					<label class="field field-weeks">
						<span class="field-label">Weeks worked per year</span>
						<span class="control control-suffix">
							<input
								id="weeks-year"
								name="weeks-year"
								type="number"
								inputmode="decimal"
								min="1"
								max="52"
								step="1"
								value={initialInput.weeksPerYear}
							/>
							<span class="affix" aria-hidden="true">weeks</span>
						</span>
						<span class="hint">Use 52 for a full year, or fewer to account for unpaid leave.</span>
					</label>
				</div>
			</details>
		</form>

		<div class="panel result-panel">
			<div class="panel-head result-head">
				<span class="mono">02 — Result</span>
				<span class="result-live">Live estimate</span>
			</div>

			<div class="headline" aria-live="polite">
				<span class="result-label" id="result-label">Estimated take-home / week</span>
				<strong class="result-value" id="net-weekly">{money(initialNetWeekly)}</strong>
				<span class="result-note" id="result-note">After 18% estimated deductions · {money(initial.weeklyGross)} gross</span>
				<span class="tax-line" id="tax-breakdown-line">
					Gross: {money(initial.weeklyGross)} | FICA (7.65%): −{money(initialFicaAmount)} | Est. Fed &amp; State Tax: −{money(initialFedStateAmount)} | Take-Home Net: {money(initialNetWeekly)}
				</span>
			</div>

			<div class="split-card">
				<div
					class="split-bar"
					id="pay-split-bar"
					role="img"
					aria-label="Gross pay split between take-home pay and taxes"
				>
					<span
						class="split-seg take-home"
						id="split-take-home"
						style={`width:${initialTakeHomeRate * 100}%`}
					></span>
					<span
						class="split-seg fed-state"
						id="split-fed-state"
						style={`width:${initialFedStateRate * 100}%`}
					></span>
					<span
						class="split-seg fica"
						id="split-fica"
						style={`width:${initialFicaRate * 100}%`}
					></span>
				</div>
				<div class="split-legend">
					<span class="legend-item">
						<i class="dot dot-take-home" aria-hidden="true"></i>
						Take-Home <strong id="split-take-home-pct">{percent(initialTakeHomeRate)}</strong>
						<em id="split-take-home-amt">{money(initialNetWeekly)}</em>
					</span>
					<span class="legend-item">
						<i class="dot dot-fed-state" aria-hidden="true"></i>
						Fed &amp; State <strong id="split-fed-state-pct">{percent(initialFedStateRate)}</strong>
						<em id="split-fed-state-amt">{money(initialFedStateAmount)}</em>
					</span>
					<span class="legend-item">
						<i class="dot dot-fica" aria-hidden="true"></i>
						FICA <strong id="split-fica-pct">{percent(initialFicaRate)}</strong>
						<em id="split-fica-amt">{money(initialFicaAmount)}</em>
					</span>
				</div>
			</div>

			<div class="stat-grid">
				<div class="stat">
					<span>Gross / week</span>
					<strong id="gross-weekly">{money(initial.weeklyGross)}</strong>
				</div>
				<div class="stat">
					<span>Take-home / year</span>
					<strong id="net-annual">{money(initial.annualGross * (1 - initialTax.rate))}</strong>
				</div>
				<div class="stat">
					<span>Gross / year</span>
					<strong id="gross-annual">{money(initial.annualGross)}</strong>
				</div>
			</div>

			<div class="budget-card">
				<div class="budget-head">
					<span class="mono">Monthly budget</span>
					<strong>Purchasing Power &amp; 50/30/20</strong>
					<span class="budget-net" id="budget-monthly-net">{money(initialMonthlyNet)}/mo net</span>
				</div>
				<div
					class="budget-bar"
					role="img"
					aria-label="Monthly budget split: 50 percent needs, 30 percent wants, 20 percent savings"
				>
					<span class="budget-seg needs" style="width:50%"></span>
					<span class="budget-seg wants" style="width:30%"></span>
					<span class="budget-seg savings" style="width:20%"></span>
				</div>
				<div class="budget-grid">
					<div class="budget-item">
						<span class="budget-label">Needs · 50%</span>
						<strong id="budget-needs">{money(initialMonthlyNet * 0.5)}/mo</strong>
						<span class="budget-rent">
							Max Safe Rent (30% rule): <b id="budget-rent">{money(initialMonthlyNet * 0.3)}/mo</b>
						</span>
					</div>
					<div class="budget-item">
						<span class="budget-label">Wants · 30%</span>
						<strong id="budget-wants">{money(initialMonthlyNet * 0.3)}/mo</strong>
					</div>
					<div class="budget-item">
						<span class="budget-label">Savings &amp; Investing · 20%</span>
						<strong id="budget-savings">{money(initialMonthlyNet * 0.2)}/mo</strong>
					</div>
				</div>
			</div>

			<div class="breakdown">
				<p class="pay-split" id="pay-split" hidden>
					Regular Pay: {money(initial.regularPay)} | Overtime Pay (1.5x/2x): +{money(initial.overtimePay + initial.doubleTimePay)} | Shift Diff: +{money(0)}
				</p>
				<div class="line">
					<span>Regular <em id="regular-hours">{hours(initial.regularHours)} hrs</em></span>
					<span id="regular-pay">{money(initial.regularPay)}</span>
				</div>
				<div class="line">
					<span><span id="overtime-rate-label">Overtime (1.5×)</span> <em id="overtime-hours">{hours(initial.overtimeHours)} hrs</em></span>
					<span id="overtime-pay">{money(initial.overtimePay)}</span>
				</div>
				<div class="line">
					<span>Double time (2×) <em id="double-hours">{hours(initial.doubleTimeHours)} hrs</em></span>
					<span id="double-pay">{money(initial.doubleTimePay)}</span>
				</div>
				<div class="line" id="shift-diff-line" hidden>
					<span>Shift differential <em id="shift-diff-rate">+$0.00/hr</em></span>
					<span id="shift-diff-pay">+{money(0)}</span>
				</div>
				<div class="line line-tax">
					<span>Estimated taxes</span>
					<span id="tax-amount">−{money(initialTaxAmount)}</span>
				</div>
				<div class="line line-net">
					<span>Net weekly</span>
					<span id="net-weekly-mini">{money(initialNetWeekly)}</span>
				</div>
			</div>

			<p class="result-disclaimer">Estimates only. Federal, state, and local withholding varies by filing status, deductions, and state rules.</p>
		</div>
	</div>

	<div class="panel table-panel">
		<div class="table-head">
			<div>
				<span class="mono">03 — Frequency</span>
				<h3>Gross and take-home by pay period</h3>
			</div>
			<p class="hint">Annual gross converted across 52 weeks. Semi-monthly pays 24 times; bi-weekly pays 26.</p>
		</div>
		<div class="table-scroll">
			<table>
				<caption class="sr-only">Estimated gross and net pay by frequency</caption>
				<thead>
					<tr>
						<th scope="col">Frequency</th>
						<th scope="col">Per year</th>
						<th scope="col" class="num">Gross</th>
						<th scope="col" class="num">Take-home</th>
					</tr>
				</thead>
				<tbody id="frequency-body">
					{initialRows.map((row) => (
						<tr>
							<td>{row.label}</td>
							<td class="muted" id={`freq-${row.key}-periods`}>{row.periodsLabel}</td>
							<td class="num" id={`freq-${row.key}-gross`}>{money(row.gross)}</td>
							<td class="num" id={`freq-${row.key}-net`}>
								{money(row.gross * (1 - initialTax.rate))}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</section>

<script>
	import {
		calculateShift,
		calculateStandard,
		FICA_RATE,
		getFrequencyRows,
		STATE_TAX_PROFILES,
		TAX_SCENARIOS,
		estimateTakeHome,
	} from '../lib/payroll';

	const root = document.getElementById('calculator');
	const form = document.getElementById('pay-form');

	if (root && form) {
		const byId = (id) => document.getElementById(id);
		const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

		const money = (value) =>
			value.toLocaleString('en-US', {
				style: 'currency',
				currency: 'USD',
				minimumFractionDigits: 2,
				maximumFractionDigits: 2,
			});

		const hours = (value) =>
			value.toLocaleString('en-US', { maximumFractionDigits: 1 });

		const readNumber = (input, min, max, fallback) => {
			const parsed = Number.parseFloat(input?.value ?? '');
			if (!Number.isFinite(parsed)) return fallback;
			return clamp(parsed, min, max);
		};

		const percent = (rate) => {
			const value = Math.round(rate * 10000) / 100;
			return `${value.toLocaleString('en-US', { maximumFractionDigits: 2 })}%`;
		};

		const activeMode = () =>
			form.querySelector('input[name="shift-mode"]:checked')?.value ?? 'standard';

		const syncPanels = () => {
			const mode = activeMode();
			root.querySelectorAll('[data-panel]').forEach((panel) => {
				panel.hidden = panel.dataset.panel !== mode;
			});
		};

		const syncDifferentialPills = (value) => {
			form.querySelectorAll('[data-differential]').forEach((button) => {
				const pillValue = Number.parseFloat(button.dataset.differential ?? '');
				button.setAttribute('aria-pressed', pillValue === value ? 'true' : 'false');
			});
		};

		const syncOvertimeInputs = (value, skip) => {
			const normalized = clamp(value, 0, 40);
			const numberInput = byId('overtime-hours');
			const sliderInput = byId('overtime-slider');
			if (numberInput && numberInput !== skip) numberInput.value = hours(normalized);
			if (sliderInput && sliderInput !== skip) sliderInput.value = String(normalized);
		};

		const getOvertimeRate = () => {
			const checked = form.querySelector('input[name="overtime-rate"]:checked');
			return Number.parseFloat(checked?.value ?? '1.5') === 2 ? 2 : 1.5;
		};

		const syncWagePills = (value) => {
			form.querySelectorAll('[data-wage]').forEach((button) => {
				const pillValue = Number.parseFloat(button.dataset.wage ?? '');
				button.setAttribute('aria-pressed', pillValue === value ? 'true' : 'false');
			});
		};

		const syncAdvancedStatus = () => {
			const status = byId('advanced-status');
			if (!status) return;

			const overtimeHours = readNumber(byId('overtime-hours'), 0, 40, 0);
			const doubleTimeHours = readNumber(byId('double-time'), 0, 168, 0);
			const differential = readNumber(byId('shift-differential'), 0, 50, 0);
			const weeksPerYear = readNumber(byId('weeks-year'), 1, 52, 52);

			const active =
				overtimeHours > 0 ||
				doubleTimeHours > 0 ||
				differential > 0 ||
				weeksPerYear !== 52 ||
				getOvertimeRate() === 2 ||
				activeMode() === 'shift';

			status.hidden = !active;
			status.textContent = active ? 'Active' : 'Optional';
		};

		const setMode = (mode) => {
			const radio = form.querySelector(
				`input[name="shift-mode"][value="${mode}"]`,
			);
			if (radio) radio.checked = true;
			syncPanels();
		};

		const render = (event) => {
			const target = event?.target;
			const mode = activeMode();

			if (
				mode === 'standard' &&
				target &&
				(target.id === 'overtime-hours' || target.id === 'overtime-slider')
			) {
				const overtimeHours = readNumber(target, 0, 40, 0);
				const doubleTimeHours = readNumber(byId('double-time'), 0, 168, 0);
				const hoursInput = byId('hours-week');
				if (hoursInput) {
					hoursInput.value = String(
						clamp(40 + overtimeHours + doubleTimeHours, 0, 168),
					);
				}
			}

			const baseHourlyRate = readNumber(byId('hourly-rate'), 0, 10000, 0);
			const differential = readNumber(byId('shift-differential'), 0, 50, 0);
			const hourlyRate = baseHourlyRate + differential;
			const weeksPerYear = readNumber(byId('weeks-year'), 1, 52, 52);

			let result;
			let baseResult;
			let payablePerShift = 0;

			if (mode === 'shift') {
				const sleepDeduction = readNumber(byId('sleep-deduction'), 0, 8, 8);
				const mealDeduction = readNumber(byId('meal-deduction'), 0, 3, 3);
				payablePerShift = Math.max(0, 24 - sleepDeduction - mealDeduction);

				const shiftInput = {
					shiftsPerWeek: readNumber(byId('shifts-week'), 0, 7, 5),
					sleepDeduction,
					mealDeduction,
					dailyOvertime: Boolean(byId('daily-overtime')?.checked),
					weeksPerYear,
				};

				baseResult = calculateShift({ ...shiftInput, hourlyRate: baseHourlyRate });
				result = calculateShift({ ...shiftInput, hourlyRate });
			} else {
				const standardInput = {
					hoursPerWeek: readNumber(byId('hours-week'), 0, 168, 40),
					doubleTimeHours: readNumber(byId('double-time'), 0, 168, 0),
					weeksPerYear,
					overtimeRate: getOvertimeRate(),
				};

				baseResult = calculateStandard({
					...standardInput,
					hourlyRate: baseHourlyRate,
				});
				result = calculateStandard({ ...standardInput, hourlyRate });
			}

			syncWagePills(baseHourlyRate);
			syncDifferentialPills(differential);
			if (mode === 'standard') {
				syncOvertimeInputs(result.overtimeHours, target);
			}
			syncAdvancedStatus();

			const scenarioKey = byId('tax-scenario')?.value ?? 'standard';
			const stateKey = scenarioKey.startsWith('state:')
				? scenarioKey.slice(6)
				: '';
			const stateProfile =
				stateKey && stateKey in STATE_TAX_PROFILES
					? STATE_TAX_PROFILES[stateKey as keyof typeof STATE_TAX_PROFILES]
					: null;

			let taxRate = TAX_SCENARIOS.standard.rate;
			let ficaRate = Math.min(FICA_RATE, taxRate);
			let fedStateRate = Math.max(0, taxRate - ficaRate);
			let resultNote = '';

			if (stateProfile) {
				const estimate = estimateTakeHome(
					result.annualGross,
					stateKey as keyof typeof STATE_TAX_PROFILES,
				);
				taxRate = estimate.totalRate;
				ficaRate = estimate.ficaRate;
				fedStateRate = estimate.federalRate + estimate.stateRate;
				resultNote = `Federal + ${percent(estimate.ficaRate)} FICA + ${percent(estimate.stateRate)} state · ${money(result.weeklyGross)} gross`;
			} else {
				const scenario =
					TAX_SCENARIOS[scenarioKey as keyof typeof TAX_SCENARIOS] ??
					TAX_SCENARIOS.standard;
				taxRate = scenario.rate;
				ficaRate = Math.min(FICA_RATE, taxRate);
				fedStateRate = Math.max(0, taxRate - ficaRate);
				resultNote =
					taxRate === 0
						? `No deductions applied · ${money(result.weeklyGross)} gross`
						: `After ${percent(taxRate)} estimated deductions · ${money(result.weeklyGross)} gross`;
			}

			const taxAmount = result.weeklyGross * taxRate;
			const ficaAmount = result.weeklyGross * ficaRate;
			const fedStateAmount = result.weeklyGross * fedStateRate;
			const netWeekly = result.weeklyGross - taxAmount;
			const netAnnual = result.annualGross - result.annualGross * taxRate;

			byId('net-weekly').textContent = money(netWeekly);
			byId('gross-weekly').textContent = money(result.weeklyGross);
			byId('net-annual').textContent = money(netAnnual);
			byId('gross-annual').textContent = money(result.annualGross);

			const takeHomeShare =
				result.weeklyGross > 0 ? netWeekly / result.weeklyGross : 0;
			const fedStateShare =
				result.weeklyGross > 0 ? fedStateAmount / result.weeklyGross : 0;
			const ficaShare =
				result.weeklyGross > 0 ? ficaAmount / result.weeklyGross : 0;

			byId('split-take-home').style.width = `${takeHomeShare * 100}%`;
			byId('split-fed-state').style.width = `${fedStateShare * 100}%`;
			byId('split-fica').style.width = `${ficaShare * 100}%`;
			byId('split-take-home-pct').textContent = percent(takeHomeShare);
			byId('split-fed-state-pct').textContent = percent(fedStateShare);
			byId('split-fica-pct').textContent = percent(ficaShare);
			byId('split-take-home-amt').textContent = money(netWeekly);
			byId('split-fed-state-amt').textContent = money(fedStateAmount);
			byId('split-fica-amt').textContent = money(ficaAmount);
			byId('pay-split-bar').setAttribute(
				'aria-label',
				`Take-home ${percent(takeHomeShare)}, federal and state tax ${percent(fedStateShare)}, FICA ${percent(ficaShare)} of gross pay`,
			);

			const monthlyNet = netAnnual / 12;
			byId('budget-monthly-net').textContent = `${money(monthlyNet)}/mo net`;
			byId('budget-needs').textContent = `${money(monthlyNet * 0.5)}/mo`;
			byId('budget-rent').textContent = `${money(monthlyNet * 0.3)}/mo`;
			byId('budget-wants').textContent = `${money(monthlyNet * 0.3)}/mo`;
			byId('budget-savings').textContent = `${money(monthlyNet * 0.2)}/mo`;

			byId('result-label').textContent =
				taxRate === 0 ? 'Estimated gross / week' : 'Estimated take-home / week';
			byId('result-note').textContent = resultNote;
			byId('tax-breakdown-line').textContent =
				`Gross: ${money(result.weeklyGross)} | FICA (7.65%): ${ficaAmount === 0 ? money(0) : `−${money(ficaAmount)}`} | Est. Fed & State Tax: ${fedStateAmount === 0 ? money(0) : `−${money(fedStateAmount)}`} | Take-Home Net: ${money(netWeekly)}`;

			byId('regular-hours').textContent = `${hours(baseResult.regularHours)} hrs`;
			byId('regular-pay').textContent = money(baseResult.regularPay);
			const overtimeRateLabel = byId('overtime-rate-label');
			if (overtimeRateLabel) {
				overtimeRateLabel.textContent =
					mode === 'standard'
						? `Overtime (${getOvertimeRate() === 2 ? '2' : '1.5'}×)`
						: 'Overtime';
			}
			const overtimeHoursReadout = root.querySelector(
				'.breakdown #overtime-hours',
			);
			if (overtimeHoursReadout) {
				overtimeHoursReadout.textContent = `${hours(baseResult.overtimeHours)} hrs`;
			}
			byId('overtime-pay').textContent = money(baseResult.overtimePay);
			byId('double-hours').textContent = `${hours(baseResult.doubleTimeHours)} hrs`;
			byId('double-pay').textContent = money(baseResult.doubleTimePay);

			const shiftDiffPay = Math.max(0, result.weeklyGross - baseResult.weeklyGross);
			const shiftDiffLine = byId('shift-diff-line');
			if (shiftDiffLine) shiftDiffLine.hidden = differential <= 0;
			byId('shift-diff-rate').textContent = `+${money(differential)}/hr`;
			byId('shift-diff-pay').textContent = `+${money(shiftDiffPay)}`;

			const paySplit = byId('pay-split');
			if (paySplit) {
				const hasOvertime =
					baseResult.overtimeHours > 0 || baseResult.doubleTimeHours > 0;
				const showSplit = hasOvertime || differential > 0;
				paySplit.hidden = !showSplit;
				if (showSplit) {
					paySplit.textContent =
						`Regular Pay: ${money(baseResult.regularPay)} | Overtime Pay (1.5x/2x): +${money(baseResult.overtimePay + baseResult.doubleTimePay)} | Shift Diff: +${money(shiftDiffPay)}`;
				}
			}

			byId('tax-amount').textContent =
				taxAmount === 0 ? money(0) : `−${money(taxAmount)}`;
			byId('net-weekly-mini').textContent = money(netWeekly);

			const payableReadout = byId('payable-per-shift');
			if (payableReadout) payableReadout.textContent = `${hours(payablePerShift)} hrs`;

			const rows = getFrequencyRows(result, hourlyRate, weeksPerYear);
			rows.forEach((row) => {
				const periods = byId(`freq-${row.key}-periods`);
				const gross = byId(`freq-${row.key}-gross`);
				const net = byId(`freq-${row.key}-net`);
				if (periods) periods.textContent = row.periodsLabel;
				if (gross) gross.textContent = money(row.gross);
				if (net) net.textContent = money(row.gross * (1 - taxRate));
			});
		};

		form.querySelectorAll('input[name="shift-mode"]').forEach((input) => {
			input.addEventListener('change', () => {
				syncPanels();
				render();
			});
		});

		form.querySelectorAll('[data-differential]').forEach((button) => {
			button.addEventListener('click', () => {
				const input = byId('shift-differential');
				if (!input) return;
				input.value = button.dataset.differential ?? '0';
				render();
			});
		});

		form.querySelectorAll('[data-wage]').forEach((button) => {
			button.addEventListener('click', () => {
				const input = byId('hourly-rate');
				if (!input) return;
				input.value = button.dataset.wage ?? '';
				render();
			});
		});

		const pathname = window.location.pathname.replace(/\/+$/, '') || '/';
		if (pathname === '/') {
			document
				.querySelectorAll(
					'.site-header a[href="/overtime-calculator"], .site-header a[href="/24-hour-shift-calculator"]',
				)
				.forEach((link) => {
					link.addEventListener('click', (event) => {
						if (
							event.defaultPrevented ||
							event.button !== 0 ||
							event.metaKey ||
							event.ctrlKey ||
							event.shiftKey ||
							event.altKey
						) {
							return;
						}

						const isShift =
							link.getAttribute('href') === '/24-hour-shift-calculator';
						event.preventDefault();
						setMode(isShift ? 'shift' : 'standard');

						const advanced = byId('advanced-options');
						if (advanced) advanced.open = true;
						render();

						advanced?.scrollIntoView({ behavior: 'smooth', block: 'center' });
						const focusTarget = isShift
							? byId('sleep-deduction')
							: byId('overtime-hours');
						window.setTimeout(
							() => focusTarget?.focus({ preventScroll: true }),
							250,
						);
					});
				});
		}

		root.addEventListener('input', render);
		root.addEventListener('change', render);

		syncPanels();
		render();
	}
</script>

