<script>
	import { calculateOvertime, TAX_SCENARIOS } from '../lib/payroll';

	const root = document.getElementById('ot-form');
	const resultPanel = document.querySelector('.result-panel');

	if (root && resultPanel) {
		const byId = (id) => document.getElementById(id);
		const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

		const money = (value) =>
			value.toLocaleString('en-US', {
				style: 'currency',
				currency: 'USD',
				minimumFractionDigits: 2,
				maximumFractionDigits: 2,
			});

		const hours = (value) =>
			value.toLocaleString('en-US', { maximumFractionDigits: 1 });

		const readNumber = (id, fallback, min, max) => {
			const input = byId(id);
			const parsed = Number.parseFloat(input?.value ?? '');
			if (!Number.isFinite(parsed)) return fallback;
			return clamp(parsed, min, max);
		};

		const setRateState = (rate) => {
			root.querySelectorAll('[data-rate]').forEach((button) => {
				button.setAttribute(
					'aria-pressed',
					Math.abs(Number(button.dataset.rate) - rate) < 0.001 ? 'true' : 'false',
				);
			});
		};

		const render = () => {
			const hourlyRate = readNumber('ot-rate', 20, 0, 10000);
			const regularHours = readNumber('ot-regular-hours', 40, 0, 168);
			const overtimeHours = readNumber('ot-overtime-hours', 10, 0, 168);
			const doubleTimeHours = readNumber('ot-double-hours', 0, 0, 168);

			const result = calculateOvertime({
				hourlyRate,
				regularHours,
				overtimeHours,
				doubleTimeHours,
			});

			const scenarioKey = byId('ot-tax')?.value ?? 'standard';
			const taxRate = TAX_SCENARIOS[scenarioKey]?.rate ?? TAX_SCENARIOS.standard.rate;
			const taxAmount = result.weeklyGross * taxRate;
			const net = result.weeklyGross - taxAmount;
			const biWeeklyNet = result.biWeeklyGross * (1 - taxRate);
			const semiMonthlyNet = result.semiMonthlyGross * (1 - taxRate);
			const monthlyNet = result.monthlyGross * (1 - taxRate);
			const annualNet = result.annualGross * (1 - taxRate);

			setRateState(hourlyRate);

			byId('ot-rate-15').textContent = money(result.timeAndHalfRate);
			byId('ot-rate-2').textContent = money(result.doubleTimeRate);
			byId('ot-weekly-gross').textContent = money(result.weeklyGross);
			byId('ot-net').textContent = money(net);
			byId('ot-tax-note').textContent =
				taxRate === 0 ? 'no taxes applied' : `after ${Math.round(taxRate * 10000) / 100}% estimated deductions`;

			byId('ot-regular-hours-out').textContent = `${hours(regularHours)} hrs × 1×`;
			byId('ot-regular-pay').textContent = money(result.regularPay);
			byId('ot-overtime-hours-out').textContent = `${hours(overtimeHours)} hrs × 1.5×`;
			byId('ot-overtime-pay').textContent = money(result.overtimePay);
			byId('ot-double-hours-out').textContent = `${hours(doubleTimeHours)} hrs × 2×`;
			byId('ot-double-pay').textContent = money(result.doubleTimePay);
			byId('ot-tax-amount').textContent =
				taxAmount === 0 ? money(0) : `−${money(taxAmount)}`;
			byId('ot-net-weekly').textContent = money(net);

			byId('ot-biweekly').textContent = money(result.biWeeklyGross);
			byId('ot-biweekly-net').textContent = money(biWeeklyNet);
			byId('ot-semimonthly').textContent = money(result.semiMonthlyGross);
			byId('ot-semimonthly-net').textContent = money(semiMonthlyNet);
			byId('ot-monthly').textContent = money(result.monthlyGross);
			byId('ot-monthly-net').textContent = money(monthlyNet);
			byId('ot-annual').textContent = money(result.annualGross);
			byId('ot-annual-net').textContent = money(annualNet);

			const flsaNote = byId('flsa-note');
			if (flsaNote) {
				const total = regularHours + overtimeHours + doubleTimeHours;
				flsaNote.textContent =
					total > 40
						? `${hours(total)} total hours this week. Hours above 40 are overtime under federal FLSA rules — confirm that your 1.5× hours are at least the excess.`
						: `${hours(total)} total hours this week. That is at or below 40, so federal weekly overtime may not apply unless a state daily rule does.`;
			}
		};

		root.querySelectorAll('[data-rate]').forEach((button) => {
			button.addEventListener('click', () => {
				byId('ot-rate').value = Number(button.dataset.rate);
				render();
			});
		});

		['ot-rate', 'ot-regular-hours', 'ot-overtime-hours', 'ot-double-hours'].forEach((id) => {
			const input = byId(id);
			if (!input) return;
			input.addEventListener('input', render);
		});

		byId('ot-tax')?.addEventListener('change', render);

		render();
	}
</script>

