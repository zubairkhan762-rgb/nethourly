---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Calculator from '../../components/Calculator.astro';
import EditorialGuide from '../../components/EditorialGuide.astro';
import FaqSection from '../../components/FaqSection.astro';
import Layout from '../../layouts/Layout.astro';
import { estimateTakeHome, getFederalMarginalRate } from '../../lib/payroll';
import {
	STATE_MINIMUM_WAGES,
	WAGE_TAX_TIERS,
	WAGES,
	formatRate,
	formatUSD,
	getNearbyWages,
	getWageStats,
	type WageEntry,
} from '../../data/wages';

export function getStaticPaths() {
	return WAGES.map((wage, index) => ({
		params: { slug: wage.slug },
		props: { wage, index },
	}));
}

interface Props {
	wage: WageEntry;
	index: number;
}

const { wage, index } = Astro.props;

const stats = getWageStats(wage.rate);
const standardTax = 0.18;
const netAnnual = stats.annual * (1 - standardTax);
const netBiWeekly = stats.biWeekly * (1 - standardTax);

const prevWage = WAGES[index - 1];
const nextWage = WAGES[index + 1];
const nearby = getNearbyWages(wage.slug, 6);

const money = (value: number) => formatUSD(value, 0);
const rateMoney = (value: number) => formatRate(value);
const percent = (value: number) =>
	`${(Math.round(value * 10000) / 100).toLocaleString('en-US', { maximumFractionDigits: 2 })}%`;

const netWeekly = stats.weekly * (1 - standardTax);
const netMonthly = stats.monthly * (1 - standardTax);
const fiveHoursOvertime = 5 * stats.overtimeRate;
const weeklyWithFiveOvertime = stats.weekly + fiveHoursOvertime;
const rentCap = stats.monthly * 0.3;
const landlordRentCap = stats.monthly / 3;
const needsBudget = netMonthly * 0.5;
const wantsBudget = netMonthly * 0.3;
const savingsBudget = netMonthly * 0.2;
const nextMilestone = (Math.floor(stats.annual / 10000) + 1) * 10000;
const gapToNext = nextMilestone - stats.annual;
const overtimeHoursToNext = gapToNext / stats.overtimeRate;
const weeksAtFiveOvertime = overtimeHoursToNext / 5;
const fiveOvertimeAnnual = 5 * stats.overtimeRate * 52;
const overtimeHoursText = Math.ceil(overtimeHoursToNext).toLocaleString('en-US');
const overtimeWeeksText =
	weeksAtFiveOvertime < 1
		? weeksAtFiveOvertime.toFixed(1)
		: Math.ceil(weeksAtFiveOvertime).toLocaleString('en-US');
const nextMilestoneText = `At ${rateMoney(stats.overtimeRate)}/hr overtime, the next $10,000 milestone (${money(nextMilestone)} annual gross) is about ${overtimeHoursText} overtime hours, or ${overtimeWeeksText} weeks at five overtime hours a week.`;

const aboveFederal = wage.rate - 7.25;
const federalNote =
	aboveFederal > 0 ? `${rateMoney(aboveFederal)} above` : 'equal to';
const stateFloorNote =
	wage.rate >= 20
		? `It is also above the $15–$20 range that several states and cities have adopted as their minimum.`
		: wage.rate >= 15
			? `It is within the $15–$20 range that several states and cities have adopted as their minimum.`
			: `It is below the $15–$20 range that several states and cities have adopted as their minimum.`;

const noStateTax = estimateTakeHome(stats.annual, 'noState');
const moderateStateTax = estimateTakeHome(stats.annual, 'moderateState');
const highStateTax = estimateTakeHome(stats.annual, 'highState');
const noStateNetAnnual = noStateTax.netAnnual;
const moderateStateNetAnnual = moderateStateTax.netAnnual;
const highStateNetAnnual = highStateTax.netAnnual;
const stateTaxGap = noStateNetAnnual - highStateNetAnnual;
const US_MEDIAN_INDIVIDUAL_INCOME = 50000;
const medianGap = stats.annual - US_MEDIAN_INDIVIDUAL_INCOME;
const medianNote =
	medianGap >= 0
		? `${money(Math.abs(medianGap))} above`
		: `${money(Math.abs(medianGap))} below`;
const federalMarginalRate = getFederalMarginalRate(stats.annual);
const federalEffectiveRate = noStateTax.federalRate;
const mortgageHousingCap = stats.monthly * 0.28;
const mortgageDebtCap = stats.monthly * 0.36;

const wageTier = (() => {
	if (wage.rate < 17) {
		const roles =
			'retail associate, food-service worker, fulfillment center associate, cashier, and janitorial or home-health aide';
		return {
			label: 'Entry-level & minimum-wage tier',
			meta: 'Entry-level pay near federal and state minimums, with studio and shared-housing math plus retail, food-service, and fulfillment roles.',
			paragraphs: [
				`At ${wage.display}/hr, full-time gross pay is ${money(stats.annual)} a year. That is ${federalNote} the $7.25 federal minimum wage. ${stateFloorNote} The 30% rent target here is ${money(rentCap)} a month, so a studio or shared apartment needs to stay near that line; in most metros that means roommates or a smaller unit.`,
				`Typical roles at this level are ${roles}. Schedules and hours can matter more than the nominal rate, especially when overtime, shift differentials, or tipped pay are in the mix.`,
				`A small raise can also collide with benefits. SNAP, Medicaid, the EITC, and housing assistance may phase out as income rises, so compare the raise in net cash rather than gross pay.`,
				`Five overtime hours a week at 1.5x adds ${money(fiveHoursOvertime)} weekly and ${money(fiveOvertimeAnnual)} a year at this rate. ${nextMilestoneText}`,
			],
			faq: {
				question: `What jobs pay ${wage.display} an hour, and is it above minimum wage?`,
				answer: `At ${wage.display}/hr, full-time pay is ${money(stats.annual)} gross a year. That is ${federalNote} the $7.25 federal minimum. ${stateFloorNote} Typical roles include ${roles}.`,
			},
		};
	}
	if (wage.rate < 25) {
		const roles =
			'administrative assistant, delivery driver, medical assistant, warehouse lead, customer service representative, and entry-level dispatcher';
		return {
			label: 'Early-career & skilled-support tier',
			meta: 'Early-career pay with 1-bedroom rent math, overtime impact, and admin, delivery, medical-support, and warehouse-lead roles.',
			paragraphs: [
				`At ${wage.display}/hr, gross annual pay is ${money(stats.annual)}. A 1-bedroom in a moderate-cost US city often rents for $1,200 to $1,600 a month. The 30% rent target here is ${money(rentCap)} a month, so a one-bedroom is comfortable only where local rents stay near that line; otherwise plan on a roommate or a cheaper neighborhood.`,
				`Five overtime hours a week at 1.5x adds ${money(fiveHoursOvertime)} weekly, or ${money(fiveOvertimeAnnual)} a year before taxes. That lifts gross annual pay to ${money(weeklyWithFiveOvertime * 52)}. ${nextMilestoneText}`,
				`Typical roles include ${roles}. A CDL, medical-assistant credential, or warehouse leadership role is a common next step.`,
				`The landlord's 3x screen allows ${money(landlordRentCap)} a month, but the 30% target is ${money(rentCap)}. The gap of ${money(landlordRentCap - rentCap)} a month is money for utilities, food, and savings, not extra rent.`,
			],
			faq: {
				question: `Is ${wage.display} an hour enough for a 1-bedroom apartment?`,
				answer: `At ${wage.display}/hr, gross monthly pay is ${money(stats.monthly)} and estimated monthly take-home is ${money(netMonthly)}. The 30% rent target is ${money(rentCap)} a month, while a landlord's 3x gross screen allows ${money(landlordRentCap)}. Five overtime hours a week adds ${money(fiveOvertimeAnnual)} a year before taxes.`,
			},
		};
	}
	if (wage.rate < 36) {
		const roles =
			'licensed practical nurse, electrician, HVAC technician, dental hygienist, bookkeeper, and welder';
		return {
			label: 'Mid-career & skilled-trade tier',
			meta: 'Mid-career skilled-trade pay vs. the $50,000 US median, with no-state-tax vs high-tax take-home differences.',
			paragraphs: [
				`At ${wage.display}/hr, ${money(stats.annual)} gross is ${medianNote} the $50,000 US median individual-income benchmark. At this level, certification and specialty pay usually move the number more than extra hours.`,
				`State tax changes the result. Estimated annual take-home is ${money(noStateNetAnnual)} in a 0% state such as Texas or Florida, ${money(moderateStateNetAnnual)} at a moderate 5.5% rate, and ${money(highStateNetAnnual)} in a high-tax state at 8.5%. The high-tax estimate is ${money(stateTaxGap)} less per year than the no-state estimate.`,
				`Typical roles include ${roles}. Licenses, safety certifications, and specialty endorsements are the quickest route to the next bracket.`,
				`Five overtime hours a week at 1.5x adds ${money(fiveOvertimeAnnual)} a year at this rate. ${nextMilestoneText}`,
			],
			faq: {
				question: `How does ${wage.display} an hour compare with the median US income?`,
				answer: `At ${wage.display}/hr, annual gross pay is ${money(stats.annual)}, which is ${medianNote} the $50,000 median individual-income benchmark. Estimated annual take-home ranges from ${money(highStateNetAnnual)} in a high-tax state to ${money(noStateNetAnnual)} in a no-state-tax state, a difference of ${money(stateTaxGap)}.`,
			},
		};
	}
	const roles =
		'registered nurse, software or IT specialist, project manager, senior electrician or plumber, and senior technician';
	return {
		label: 'Professional & specialist tier',
		meta: 'Professional pay with federal bracket impact, 28/36 mortgage readiness, and nursing, IT, project-management, and senior-trade roles.',
		paragraphs: [
			`At ${wage.display}/hr, ${money(stats.annual)} gross puts a single filer in the ${percent(federalMarginalRate)} federal marginal bracket after the $15,000 standard deduction. The estimated effective federal rate is ${percent(federalEffectiveRate)}, before FICA and state tax.`,
			`The 28/36 rule caps housing at ${money(mortgageHousingCap)} a month and total debt at ${money(mortgageDebtCap)} a month. At this income a mortgage may be workable, but the down payment, credit score, and existing debt decide approval more than the hourly rate.`,
			`Typical roles include ${roles}. High-skill hourly work often comes with overtime, travel, or on-call premiums, so compare the whole package rather than base pay alone.`,
			`State tax still matters. The estimated annual take-home gap between a 0% state and an 8.5% high-tax state is ${money(stateTaxGap)} at this rate. ${nextMilestoneText}`,
		],
		faq: {
			question: `Can I buy a home at ${wage.display} an hour?`,
			answer: `At ${wage.display}/hr, gross monthly pay is ${money(stats.monthly)}. The 28/36 rule allows up to ${money(mortgageHousingCap)} a month for housing and ${money(mortgageDebtCap)} a month for total debt. Estimated annual take-home is ${money(noStateNetAnnual)} in a 0% state and ${money(highStateNetAnnual)} at an 8.5% state rate.`,
		},
	};
})();

const periods = [
	{ label: 'Daily', note: '8-hour day', value: stats.daily },
	{ label: 'Weekly', note: '40 hours', value: stats.weekly },
	{ label: 'Bi-weekly', note: '26 paychecks', value: stats.biWeekly },
	{ label: 'Semi-monthly', note: '24 paychecks', value: stats.semiMonthly },
	{ label: 'Monthly', note: '12 paychecks', value: stats.monthly },
	{ label: 'Annual', note: '52 weeks', value: stats.annual },
];

const overtimeRows = [5, 10, 15].map((hours) => {
	const overtimePay = hours * stats.overtimeRate;
	const weekly = stats.weekly + overtimePay;
	return {
		hours,
		overtimePay,
		weekly,
		annual: weekly * 52,
	};
});

const scheduleRows = [
	{ hours: 20, label: 'Part-time' },
	{ hours: 30, label: 'Part-time plus' },
	{ hours: 36, label: '3×12 nurse shift' },
	{ hours: 40, label: 'Full-time' },
	{ hours: 50, label: 'Overtime-heavy' },
].map((row) => {
	const weekly = wage.rate * row.hours;
	return {
		...row,
		weekly,
		monthly: (weekly * 52) / 12,
		annual: weekly * 52,
	};
});

const title = `${wage.display} an Hour is How Much a Year? (Gross & Net After Taxes)`;
const description = `${wage.display}/hr pays ${money(stats.annual)} gross and about ${money(netAnnual)} take-home a year. ${wageTier.meta}`;

const breadcrumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Popular Wages', href: '/popular-wages' },
	{ label: `${wage.display}/hr Yearly & Bi-Weekly Pay` },
];

const faqs = [
	{
		question: `How much is ${wage.display} an hour per year in the US?`,
		answer: `At ${wage.display} an hour, working 40 hours a week for 52 weeks, annual gross pay is ${money(stats.annual)} before taxes. After an estimated 18% for standard federal income tax and FICA, take-home pay is about ${money(netAnnual)} per year. This assumes full-time hours, no unpaid time off, and no state income tax.`,
	},
	{
		question: `How much is a bi-weekly paycheck at ${wage.display} an hour?`,
		answer: `A bi-weekly pay period covers 80 hours at ${wage.display}/hr, so gross pay is ${money(stats.biWeekly)} per paycheck. Across 26 annual paychecks, estimated take-home pay is about ${money(netBiWeekly)} per paycheck after 18% federal and FICA taxes. A semi-monthly schedule instead produces 24 larger paychecks of ${money(stats.semiMonthly)} gross.`,
	},
	{
		question: `What is time and a half (1.5x overtime) for ${wage.display} an hour?`,
		answer: `Time and a half at ${wage.display} an hour is ${rateMoney(stats.overtimeRate)} per hour (${wage.display} × 1.5). Double time is ${rateMoney(stats.doubleTimeRate)} per hour (${wage.display} × 2). Five overtime hours in a week add ${money(fiveHoursOvertime)} in gross overtime pay, raising weekly gross from ${money(stats.weekly)} to ${money(weeklyWithFiveOvertime)}.`,
	},
	{
		question: `How much is ${wage.display} an hour per month and per week?`,
		answer: `At 40 hours a week, ${wage.display} an hour pays ${money(stats.weekly)} gross per week and ${money(stats.monthly)} gross per month. After an estimated 18% tax rate, take-home pay is about ${money(netWeekly)} net per week and ${money(netMonthly)} net per month.`,
	},
	{
		question: `Is ${wage.display} an hour a livable wage in the United States?`,
		answer: `${wage.display} an hour is ${money(stats.annual)} a year at full-time hours, which is ${federalNote} the $7.25 federal minimum wage. ${stateFloorNote} Using the 30% rent affordability rule, monthly rent should stay at or below ${money(rentCap)}. Whether the wage is livable depends on location, household size, benefits, and local housing costs.`,
	},
	{
		question: wageTier.faq.question,
		answer: wageTier.faq.answer,
	},
	{
		question: `How much does state tax change take-home pay at ${wage.display} an hour?`,
		answer: `At ${wage.display}/hr, annual gross pay is ${money(stats.annual)}. Estimated annual take-home is ${money(noStateNetAnnual)} in a 0% state-income-tax state such as Texas or Florida, ${money(moderateStateNetAnnual)} at a moderate 5.5% state rate, and ${money(highStateNetAnnual)} at an 8.5% high-tax state rate. The high-tax estimate is ${money(stateTaxGap)} less per year than the no-state estimate. These figures include federal income tax and 7.65% FICA and are planning estimates, not tax advice.`,
	},
];
---

<Layout title={title} description={description}>
	<Breadcrumbs items={breadcrumbs} />
	<section class="page-hero">
		<div class="mesh" aria-hidden="true"></div>
		<div class="shell hero-inner">
			<p class="eyebrow mono">Hourly wage · 40 hrs/week · 52 weeks</p>
			<h1>
				{wage.display} an Hour is How Much a Year?{' '}
				<span class="h1-sub">(Gross &amp; Net After Taxes)</span>
			</h1>
			<p class="lede">
				A full-time schedule at {wage.display} an hour pays {money(stats.annual)} a year
				before taxes. Below is the complete breakdown by pay period, tax tier, overtime
				premium, and weekly hours.
			</p>
			{wage.note && <p class="wage-note mono">{wage.note}</p>}

			<div class="answer-card">
				<span class="mono">Instant answer</span>
				<p>
					Working full-time (40 hours/week for 52 weeks) at <strong>{wage.display} an hour</strong>{' '}
					equals <strong>{money(stats.annual)} per year</strong> before taxes, or{' '}
					<strong>{money(stats.biWeekly)} bi-weekly</strong>. After standard US federal &amp;
					FICA taxes (~18%), your estimated take-home pay is{' '}
					<strong>{money(netAnnual)}/year</strong> (
					<strong>{money(netBiWeekly)} per bi-weekly paycheck</strong>).
				</p>
			</div>

			<ul class="quick-stats" aria-label="Key pay figures">
				<li>
					<span>Annual gross</span>
					<strong>{money(stats.annual)}</strong>
				</li>
				<li>
					<span>Bi-weekly gross</span>
					<strong>{money(stats.biWeekly)}</strong>
				</li>
				<li>
					<span>Annual take-home</span>
					<strong>{money(netAnnual)}</strong>
				</li>
				<li>
					<span>Bi-weekly take-home</span>
					<strong>{money(netBiWeekly)}</strong>
				</li>
			</ul>
		</div>
	</section>

	<section class="calculator-section" aria-label={`${wage.display} hourly pay calculator`}>
		<div class="shell">
			<div class="section-head compact">
				<p class="eyebrow mono">Pre-filled calculator</p>
				<h2>Adjust your hours, overtime, and taxes.</h2>
				<p>
					The calculator starts at {wage.display}/hr. Change hours per week, weeks worked,
					double-time hours, or the tax scenario and every figure updates instantly.
				</p>
			</div>
			<Calculator hourlyRate={wage.rate} />
		</div>
	</section>

	<section class="content-section" id="take-home">
		<div class="shell">
			<div class="section-head">
				<p class="eyebrow mono">Tax tiers</p>
				<h2>{wage.display} an hour by pay period and tax tier.</h2>
				<p>
					Gross pay assumes 40 hours a week for 52 weeks. Net columns apply an estimated
					flat rate to every period, so they are planning figures — not a tax return.
				</p>
			</div>

			<div class="table-card">
				<div class="table-scroll">
					<table>
						<caption class="sr-only">
							Gross and estimated take-home pay at {wage.display} an hour across tax tiers
						</caption>
						<thead>
							<tr>
								<th scope="col">Pay period</th>
								{WAGE_TAX_TIERS.map((tier) => (
									<th scope="col" class="num">
										<span class="th-label">{tier.label}</span>
										<span class="th-note">{tier.note}</span>
									</th>
								))}
							</tr>
						</thead>
						<tbody>
							{periods.map((period) => (
								<tr>
									<th scope="row">
										<span class="row-label">{period.label}</span>
										<span class="row-note">{period.note}</span>
									</th>
									{WAGE_TAX_TIERS.map((tier) => (
										<td class="num">{money(period.value * (1 - tier.rate))}</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<p class="table-footnote">
				Standard single filer estimate combines FICA (7.65%) with roughly 10.35% effective
				federal tax. No-income-tax states still pay FICA and federal tax. High-tax states add
				state income tax. Actual withholding depends on filing status, deductions, and
				location.
			</p>

			<div class="state-tax-summary">
				<div class="state-tax-head">
					<div>
						<span class="mono">State tax comparison</span>
						<h3>{wage.display}/hr annual take-home by state tax profile</h3>
					</div>
					<p>
						High-tax states leave {money(stateTaxGap)} less a year than 0% states at this
						wage.
					</p>
				</div>
				<div class="state-tax-grid">
					<article class="state-tax-card">
						<span class="mono">0% state tax</span>
						<strong>{money(noStateNetAnnual)}<span>/yr</span></strong>
						<p>TX, FL, WA, NV, TN · includes federal + 7.65% FICA</p>
					</article>
					<article class="state-tax-card">
						<span class="mono">Moderate · ~5.5%</span>
						<strong>{money(moderateStateNetAnnual)}<span>/yr</span></strong>
						<p>NY, VA, GA, NC · includes federal + FICA + state</p>
					</article>
					<article class="state-tax-card">
						<span class="mono">High · ~8.5%</span>
						<strong>{money(highStateNetAnnual)}<span>/yr</span></strong>
						<p>CA, NJ, OR, MN · includes federal + FICA + state</p>
					</article>
				</div>
			</div>
		</div>
	</section>

	<section class="content-section" id="overtime">
		<div class="shell">
			<div class="section-head">
				<p class="eyebrow mono">Overtime &amp; shifts</p>
				<h2>Overtime at {wage.display} an hour.</h2>
				<p>
					FLSA overtime applies to hours over 40 in a workweek. Double time is common for
					holidays and California hours beyond 12 in a day.
				</p>
			</div>

			<div class="rate-cards">
				<article class="rate-card">
					<span class="mono">Time and a half · 1.5×</span>
					<strong>{rateMoney(stats.overtimeRate)}<span>/hr</span></strong>
					<p>Each overtime hour adds {rateMoney(stats.overtimeRate - wage.rate)} over the base rate.</p>
				</article>
				<article class="rate-card">
					<span class="mono">Double time · 2×</span>
					<strong>{rateMoney(stats.doubleTimeRate)}<span>/hr</span></strong>
					<p>Holiday shifts and long California days can reach the double-time rate.</p>
				</article>
			</div>

			<div class="table-card">
				<div class="table-head">
					<div>
						<span class="mono">Weekly overtime</span>
						<h3>Boosted pay with 5, 10, or 15 overtime hours</h3>
					</div>
					<p class="hint">
						Base schedule: 40 regular hours per week at {wage.display}/hr, plus overtime
						at {rateMoney(stats.overtimeRate)}/hr.
					</p>
				</div>
				<div class="table-scroll">
					<table>
						<caption class="sr-only">Weekly and annual pay with overtime</caption>
						<thead>
							<tr>
								<th scope="col">Overtime hours</th>
								<th scope="col" class="num">Overtime pay</th>
								<th scope="col" class="num">Weekly total</th>
								<th scope="col" class="num">Annual total</th>
							</tr>
						</thead>
						<tbody>
							{overtimeRows.map((row) => (
								<tr>
									<th scope="row">{row.hours} hrs/week</th>
									<td class="num">{money(row.overtimePay)}</td>
									<td class="num">{money(row.weekly)}</td>
									<td class="num">{money(row.annual)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<div class="cta-row">
				<a class="button button-primary" href="/overtime-calculator">
					Open the overtime calculator
				</a>
				<a class="button button-secondary" href="/24-hour-shift-calculator">
					24-hour shift calculator
				</a>
			</div>
		</div>
	</section>

	<section class="content-section" id="hours">
		<div class="shell">
			<div class="section-head">
				<p class="eyebrow mono">Hours</p>
				<h2>Part-time vs. full-time at {wage.display} an hour.</h2>
				<p>
					Weekly pay scales linearly with hours. Monthly and annual figures assume the same
					schedule every week for 52 weeks.
				</p>
			</div>

			<div class="table-card">
				<div class="table-scroll">
					<table>
						<caption class="sr-only">
							Weekly, monthly, and annual pay by weekly hours at {wage.display} an hour
						</caption>
						<thead>
							<tr>
								<th scope="col">Schedule</th>
								<th scope="col" class="num">Hours/week</th>
								<th scope="col" class="num">Weekly</th>
								<th scope="col" class="num">Monthly</th>
								<th scope="col" class="num">Annual</th>
							</tr>
						</thead>
						<tbody>
							{scheduleRows.map((row) => (
								<tr>
									<th scope="row">{row.label}</th>
									<td class="num">{row.hours}</td>
									<td class="num">{money(row.weekly)}</td>
									<td class="num">{money(row.monthly)}</td>
									<td class="num">{money(row.annual)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<p class="table-footnote">
				At {wage.display}/hr, 40 hours a week is {money(stats.weekly)} weekly and{' '}
				{money(stats.annual)} annually. Working 20 hours a week cuts those figures in half;
				50 hours a week adds 10 hours at the regular rate unless overtime applies.
			</p>
		</div>
	</section>

	<section class="content-section" id="state-minimums">
		<div class="shell">
			<div class="section-head">
				<p class="eyebrow mono">Comparison</p>
				<h2>How {wage.display} compares to state minimums.</h2>
				<p>
					{wage.rate > 7.25
						? `${wage.display} an hour is ${rateMoney(wage.rate - 7.25)} above the federal minimum wage of $7.25.`
						: `${wage.display} an hour matches the federal minimum wage of $7.25.`}{' '}
					Several states set a higher floor, and some cities go higher still.
				</p>
			</div>

			<div class="table-card">
				<div class="table-scroll">
					<table>
						<caption class="sr-only">State minimum wage comparison</caption>
						<thead>
							<tr>
								<th scope="col">State</th>
								<th scope="col" class="num">Minimum wage</th>
								<th scope="col" class="num">Annual at 40 hrs</th>
								<th scope="col" class="num">vs. {wage.display}</th>
							</tr>
						</thead>
						<tbody>
							{STATE_MINIMUM_WAGES.map((item) => {
								const difference = wage.rate - item.rate;
								return (
									<tr>
										<th scope="row">{item.state}</th>
										<td class="num">{rateMoney(item.rate)}</td>
										<td class="num">{money(item.rate * 2080)}</td>
										<td class="num">
											{difference === 0
												? 'Parity'
												: `${difference > 0 ? '+' : '−'}${rateMoney(Math.abs(difference))}`}
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</div>
			<p class="table-footnote">
				Reference minimum wages only. State and local rates change annually — confirm the
				current figure with your state labor office. Annual values assume 2,080 hours.{' '}
				<a href="/popular-wages#state-minimums">See the full state minimum wage table</a>.
