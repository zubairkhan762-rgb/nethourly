			radial-gradient(38% 55% at 70% 44%, rgba(255, 0, 128, 0.16), transparent 72%),
			radial-gradient(30% 48% at 88% 22%, rgba(249, 203, 40, 0.22), transparent 72%);
		filter: blur(36px);
